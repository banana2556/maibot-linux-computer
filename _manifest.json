{
  "manifest_version": 2,
  "version": "1.15.0",
  "name": "Linux 沙盒电脑",
  "description": "让麦麦的 Planner 直接操作 Docker 容器里的 Linux 桌面、Chromium 浏览器和终端，可在 VPS 上自主搜索、安装软件；聊天里出现链接时提醒先打开查看内容",
  "author": {
    "name": "Luca Chen",
    "url": "https://github.com/banana2556"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/banana2556/maibot-linux-computer"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg",
      "fallback": "monitor",
      "background": "#1C272C"
    }
  },
  "capabilities": ["tool.get_definitions", "llm.generate"],
  "i18n": {
    "default_locale": "zh-CN"
  },
  "id": "luca.linux-computer"
}
